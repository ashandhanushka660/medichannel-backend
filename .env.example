# Supabase Postgres. Heroku cannot reach the direct db.<ref>.supabase.co host
# because it is IPv6-only, so use the Session pooler (port 5432) instead.
# Username is postgres.<project-ref>, not plain postgres.
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=SET_LOCALLY

# Generate three distinct Base64 values with: openssl rand -base64 32
# ENCRYPTION_KEY must never change once data exists: it encrypts patient
# identifiers and addresses at rest.
JWT_SECRET=SET_LOCALLY
ENCRYPTION_KEY=SET_LOCALLY
HMAC_SECRET=SET_LOCALLY

# Local frontend origin. Set the deployed Vercel site origin on Heroku.
APP_FRONTEND_ORIGIN=http://localhost:3000
SPRING_PROFILES_ACTIVE=dev

# First-admin bootstrap. Used only when no ADMIN account exists yet.
# Password: 8+ characters with a letter, a number and a symbol.
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=SET_LOCALLY

# Demo data is opt-in and must stay disabled in production.
APP_DEMO_SEED=false
APP_DEMO_PASSWORD=SET_LOCALLY
